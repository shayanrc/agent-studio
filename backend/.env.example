# Server-side fallback keys (optional — you can also add keys in the app via the avatar → API keys…,
# which are held in the browser and sent per-request, never persisted server-side).
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
XAI_API_KEY=
TAVILY_API_KEY=

# Where the agent reads/writes files (defaults to <repo>/workspace)
# STUDIO_WORKSPACE=
# Where db.json lives (defaults to <repo>/data)
# STUDIO_DATA_DIR=
# Backend port (default 8181)
# PORT=8181
